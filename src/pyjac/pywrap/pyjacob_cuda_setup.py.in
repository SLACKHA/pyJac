import os
from os.path import join as pjoin
from setuptools import setup
from setuptools import Extension
from Cython.Distutils import build_ext
import subprocess
import numpy

from setuptools._distutils.ccompiler import CCompiler
from pyjac.pywrap import parallel_compiler as pcc
CCompiler.compile = pcc.parallel_compile

def find_in_path(name, path):
    "Find a file in a search path"
    #adapted fom http://code.activestate.com/recipes/52224-find-a-file-given-a-search-path/
    for dir in path.split(os.pathsep):
        binpath = pjoin(dir, name)
        if os.path.exists(binpath):
            return os.path.abspath(binpath)
    return None


def locate_cuda():
    """Locate the CUDA environment on the system
    Returns a dict with keys 'home', 'nvcc', 'include', and 'lib64'
    and values giving the absolute path to each directory.
    Starts by looking for the CUDAHOME env variable. If not found, everything
    is based on finding 'nvcc' in the PATH.
    """

    # first check if the CUDAHOME env variable is in use
    if 'CUDAHOME' in os.environ:
        home = os.environ['CUDAHOME']
        nvcc = pjoin(home, 'bin', 'nvcc')
    else:
        # otherwise, search the PATH for NVCC
        nvcc = find_in_path('nvcc', os.environ['PATH'])
        if nvcc is None:
            raise EnvironmentError('The nvcc binary could not be '
                'located in your $PATH. Either add it to your path, or set $CUDAHOME')
        home = os.path.dirname(os.path.dirname(nvcc))

    # The toolkit no longer ships the samples; they moved to a separate
    # repository after CUDA 11.5. Nothing here needs them -- the only header
    # ever taken from them was helper_cuda.h, which the generated code no
    # longer includes.
    cudaconfig = {'home':home, 'nvcc':nvcc,
                  'include': pjoin(home, 'include'),
                  'lib64': pjoin(home, 'lib64')}
    for k, v in cudaconfig.items():
        if not os.path.exists(v):
            raise EnvironmentError('The CUDA %s path could not be located in %s' % (k, v))

    return cudaconfig
CUDA = locate_cuda()


def forward_host_flags(flags):
    """Rewrite a link command so nvcc can accept it.

    The flags come from Python's own build configuration, so they are written
    for the host toolchain: recent CPython contributes -fno-strict-overflow
    and -Wsign-compare, and the interpreter's own runtime search path arrives
    as -Wl,--rpath=... . nvcc rejects all of these rather than ignoring them.

    Host compiler flags are handed over with -Xcompiler, one per flag, because
    nvcc treats a -Xcompiler argument as a comma-separated list.

    That same splitting is why linker flags need -Xlinker rather than
    -Xcompiler: -Wl,--rpath=DIR passed through -Xcompiler arrives at gcc as
    two arguments, -Wl and --rpath=DIR, and gcc understands neither alone.
    -Wl,a,b is gcc's spelling for handing a and b to the linker, so each part
    becomes its own -Xlinker.
    """
    direct = []
    forwarded = []
    for flag in flags:
        if flag.startswith('-Wl,'):
            for part in flag[len('-Wl,'):].split(','):
                if part:
                    forwarded += ['-Xlinker', part]
        elif flag.startswith('-f') or flag.startswith('-W') or flag == '-pthread':
            forwarded += ['-Xcompiler', flag]
        else:
            direct.append(flag)
    return direct + forwarded


def strip_linker_options(command):
    """Remove -Xlinker pairs from a command.

    The device link produces a relocatable device object rather than a shared
    library, so linker options such as a runtime search path have nothing to
    act on there.
    """
    kept = []
    drop_next = False
    for item in command:
        if drop_next:
            drop_next = False
        elif item == '-Xlinker':
            drop_next = True
        else:
            kept.append(item)
    return kept


# Obtain the numpy include directory.  This logic works across numpy versions.
try:
    numpy_include = numpy.get_include()
except AttributeError:
    numpy_include = numpy.get_numpy_include()

sources = ['$homepath/pyjacob_cuda_wrapper.pyx',
           '$homepath/pyjacob.cu']
includes = ['$buildpath', '$homepath']

# Look for file with list of Jacobian files
if os.path.exists('$buildpath/rates') and os.path.isfile('$buildpath/rates/rate_list_cuda'):
    includes += ['$buildpath/rates/']

# Look for file with list of Jacobian files
if os.path.exists('$buildpath/jacobs') and os.path.isfile('$buildpath/jacobs/jac_list_cuda'):
    includes += ['$buildpath/jacobs/']

ext = Extension('cu_pyjacob',
                sources=sources,
                library_dirs=[CUDA['lib64']],
                libraries=['cudart'],
                language='c++',
                #runtime_library_dirs=[CUDA['lib64']],
                # this syntax is specific to this build system
                # we're only going to use certain compiler args with nvcc and not with gcc
                # the implementation of this trick is in customize_compiler() below
                # --disable-optimizer-constants matches pyjac.libgen: a large
                # mechanism overruns the constant bank ptxas promotes literals
                # into, and the device link fails outright on some
                # architectures. See the note in libgen.flags.
                extra_compile_args={'gcc': [],
                                    'nvcc': ['-arch=$cudaarch', '--ptxas-options=-v',
                                    '-Xptxas', '--disable-optimizer-constants',
                                    '--compiler-options', "'-fPIC'",
                                    '--ftz=false', '--prec-div=true',
                                    '--prec-sqrt=true', '-m64']},
                include_dirs = [numpy_include, CUDA['include']] + includes
                )


def customize_linker_for_nvcc(self):
    """
    same as below, but link w/ NVCC
    """

    # Every list distutils might build a link command from. The _cxx variants
    # are the ones that matter here: this extension declares language='c++',
    # so distutils composes the command from compiler_cxx plus the linker
    # portion of linker_so_cxx. Rewriting only linker_so leaves that portion
    # holding raw host flags, which nvcc rejects. They are absent on older
    # setuptools, hence the getattr.
    LINKER_LISTS = ('linker_so', 'linker_exe', 'linker_so_cxx',
                    'linker_exe_cxx', 'compiler_cxx')

    #save references
    defaults = {name: getattr(self, name)[:]
                for name in LINKER_LISTS if getattr(self, name, None)}
    super = self.link

    def link(target_desc, objects,
             output_filename, output_dir=None, libraries=None,
             library_dirs=None, runtime_library_dirs=None,
             export_symbols=None, debug=0, extra_preargs=None,
             extra_postargs=None, build_temp=None, target_lang=None):

        for name in defaults:
            command = [CUDA['nvcc'] if 'gcc' in x or 'g++' in x else x
                       for x in getattr(self, name)]
            setattr(self, name, forward_host_flags(command))

        # Runtime library directories are rendered as -Wl,--rpath=... by
        # distutils itself, inside the call below, so they cannot be caught by
        # forward_host_flags above. nvcc rejects them. The device link has no
        # use for a runtime search path at all, and the shared link needs the
        # same thing expressed with -Xlinker.
        rpath = []
        for directory in runtime_library_dirs or []:
            rpath += ['-Xlinker', '--rpath=' + directory]

        #some more shenanegains to generate the dlink
        # -shared has to come out of whichever list ends up supplying it; the
        # device link produces a relocatable object, not a shared library.
        shared_save = {name: getattr(self, name)[:] for name in defaults}
        for name in defaults:
            trimmed = [x for x in getattr(self, name) if not '-shared' in x]
            setattr(self, name, strip_linker_options(trimmed))
        obj_filt = [x for x in objects if 'pyjacob.o' in x]
        super('object', obj_filt + ['$libname'], 'cuda_link.o', build_temp,
                libraries, library_dirs, [], export_symbols,
                debug, ['-arch=$cudaarch', '--compiler-options', '"-fPIC"', '-dlink'],
                extra_postargs, build_temp, target_lang)

        #now call the actual link, with the extra dlink object
        for name, value in shared_save.items():
            setattr(self, name, value[:])

        super(target_desc, objects + [os.path.join(build_temp, 'cuda_link.o'), '$libname'],
            output_filename, output_dir,
            libraries, library_dirs, [], export_symbols,
            debug, extra_preargs, (extra_postargs or []) + rpath, build_temp, target_lang)

        #restore
        for name, value in defaults.items():
            setattr(self, name, value[:])

    self.link = link



def customize_compiler_for_nvcc(self):
    """inject deep into the compiler machinery to customize how the dispatch
    to gcc/nvcc works.

    If you subclass UnixCCompiler, it's not trivial to get your subclass
    injected in, and still have the right customizations (i.e.
    customize_compiler) run on it. So instead of going
    the OO route, I have this. Note, it's kindof like a wierd functional
    subclassing going on."""

    # tell the compiler it can processes .cu
    self.src_extensions.append('.cu')

    # save references to the default compiler_so and _comple methods
    default_compiler_so = self.compiler_so
    super = self._compile

    # now redefine the _compile method. This gets executed for each
    # object but the build system doesn't have the ability to change compilers
    # based on source extension: we add it.
    def _compile(obj, src, ext, cc_args, extra_postargs, pp_opts):
        if os.path.splitext(src)[1] == '.cu':
            # use the cuda for .cu files
            self.set_executable('compiler_so', CUDA['nvcc'])
            the_cc = cc_args[:]
            # use only a subset of the extra_postargs, which are 1-1 translated
            # from the extra_compile_args in the Extension class
            postargs = extra_postargs['nvcc'][:]
            the_cc.extend(postargs)
            the_cc.append('-dc')
            postargs = []
        else:
            the_cc = cc_args[:]
            postargs = extra_postargs['gcc'][:]

        super(obj, src, ext, the_cc, postargs, pp_opts)
        # reset the default compiler_so, which we might have changed for cuda
        self.compiler_so = default_compiler_so

    # inject our redefined _compile method into the class
    self._compile = _compile


# run the customize_compiler
class custom_build_ext(build_ext):
    def build_extensions(self):
        customize_compiler_for_nvcc(self.compiler)
        customize_linker_for_nvcc(self.compiler)
        build_ext.build_extensions(self)

setup(name='cu_pyjacob',
      ext_modules = [ext],
      # inject our custom trigger
      cmdclass={'build_ext': custom_build_ext},
      # since the package has c code, the egg cannot be zipped
      zip_safe=False)
